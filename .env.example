# Copy this file to .env and adjust values. Never commit your real .env.
# All variables are prefixed GARVIS_ and map to app/core/config.py:Settings.

# Must be 'tiered' (the default): every request goes to Claude Haiku 5.5 via the
# Anthropic API (ANTHROPIC_API_KEY below). No other model or provider is ever
# used -- other values are refused at startup. Garvis never runs an AI model locally.
GARVIS_LLM_PROVIDER=tiered

# The only model: Claude Haiku 5.5 through the official Anthropic API.
# Your Claude API key (platform.claude.com > Settings > API keys). Easiest,
# with hidden input: python scripts/check_anthropic.py --set-key
# Keep it here in Garvis's .env, not in a global Windows environment variable
# (other tools such as Claude Code read a global ANTHROPIC_API_KEY too).
# Empty = every request fails with an error asking for the key. Never commit a real key.
ANTHROPIC_API_KEY=
# GARVIS_ANTHROPIC_REQUEST_TIMEOUT_SECONDS=45

# GARVIS_LLM_MODEL_REGISTRY_PATH=config/models.json
# History token budget; unset = 12000 for tiered.
# GARVIS_MAX_CONTEXT_TOKENS=

# Cost controls. Local limits on Garvis's own
# estimates -- NOT a billing cap; set a spend limit in the Anthropic Console too.
# GARVIS_LLM_BUDGET_ENABLED=true
# GARVIS_LLM_MAX_CALLS_PER_TASK=15
# GARVIS_LLM_MAX_COST_PER_TASK_USD=0.05
# GARVIS_LLM_DAILY_BUDGET_USD=0.50
# GARVIS_LLM_MONTHLY_BUDGET_USD=5.00
# GARVIS_LLM_MAX_PROMPT_TOKENS=60000
# GARVIS_LLM_MAX_RETRIES=1
# GARVIS_LLM_RETRY_BACKOFF_SECONDS=2.0
# GARVIS_LLM_USAGE_DB_PATH=data/usage.db

# Garvis no longer uses OmniRoute, Gemini, Groq or OpenRouter (single-model
# policy): their GARVIS_*_API_KEY settings are ignored for model requests.
# scripts/check_omniroute.py can still check a running OmniRoute's security.

GARVIS_STT_PROVIDER=faster_whisper
GARVIS_STT_MODEL=base
GARVIS_STT_DEVICE=cpu
GARVIS_STT_COMPUTE_TYPE=int8
GARVIS_STT_SAMPLE_RATE=16000

GARVIS_TTS_PROVIDER=piper
GARVIS_TTS_VOICE=en_US-lessac-medium
# Directory holding downloaded Piper voice models (<voice>.onnx + .onnx.json).
GARVIS_TTS_VOICE_DIR=data/voices
# Only set this if you're using a standalone piper binary instead of the
# piper-tts pip package (the default).
# GARVIS_TTS_EXECUTABLE=C:\path\to\piper.exe

# Hands-free conversation session (the "Start Session" button) tuning.
# Defaults are a starting point for a quiet-ish room with a normal mic --
# tune if speech isn't detected reliably or accidental noise triggers it.
# GARVIS_SESSION_POLL_INTERVAL_SECONDS=0.03
# GARVIS_SESSION_ENERGY_THRESHOLD=500.0
# GARVIS_SESSION_MIN_SPEECH_SECONDS=0.15
# GARVIS_SESSION_MIN_SILENCE_SECONDS=0.7
# GARVIS_SESSION_BARGE_IN_ENERGY_THRESHOLD=900.0
# GARVIS_SESSION_MAX_UTTERANCE_SECONDS=30.0
# Barge-in echo guard: tells Garvis's own voice from the speakers apart from
# new speech. Margin: higher = fewer false
# interruptions, lower = catches quieter interruptions.
# GARVIS_SESSION_ECHO_GUARD_ENABLED=true
# GARVIS_SESSION_ECHO_MARGIN=0.2
# GARVIS_TTS_PLAYBACK_BACKEND=sounddevice

GARVIS_LOG_LEVEL=INFO

# Browser automation (Phase 7). Visible by default so browser actions are
# easy to observe/debug; set to true for unattended/background use.
GARVIS_BROWSER_HEADLESS=false
GARVIS_BROWSER_NAV_TIMEOUT_MS=15000
GARVIS_BROWSER_ACTION_TIMEOUT_MS=10000
# chrome = drive the installed Google Chrome (falls back to bundled Chromium).
GARVIS_BROWSER_CHANNEL=chrome

# Desktop control (mouse/keyboard/windows/screen tools).
GARVIS_DESKTOP_CONTROL_ENABLED=true
# false (default) = routine clicks/typing run directly; only committing actions
# (Send/Delete/Pay buttons, Enter in terminal/chat/mail apps, send hotkeys) ask first.
# true = confirm every mouse/keyboard action.
GARVIS_DESKTOP_CONFIRM_INPUT_ACTIONS=false
# System-wide shortcut that brings Garvis to the front (empty = off). To also start
# Garvis with it: python scripts/install_shortcut.py
# GARVIS_GLOBAL_HOTKEY=ctrl+alt+g
# GARVIS_DESKTOP_COMMIT_GUARD_APPS=        (empty = built-in terminal/chat/mail list)
# Tell the model which window is active / which apps are open, every turn.
# GARVIS_DESKTOP_CONTEXT_IN_PROMPT=true
# Max tool round-trips per request (multi-step tasks need more than a few).
# GARVIS_AGENT_MAX_TOOL_ITERATIONS=15
# OCR for read_screen_text: empty = auto-detect (PATH, Program Files, LocalAppData).
# GARVIS_OCR_TESSERACT_PATH=
# GARVIS_OCR_LANGUAGES=eng+heb

# Garvis workspace: a separate virtual desktop for background work (research, pages
# you didn't ask to see). false = no background desktop: web_research then runs in a visible
# window on your screen (its result says so), and explicit background requests fail.
GARVIS_WORKSPACE_ENABLED=true
GARVIS_WORKSPACE_NAME=Garvis
# web_research: duckduckgo or bing; pages read per task; chars kept per page.
GARVIS_RESEARCH_SEARCH_ENGINE=duckduckgo
GARVIS_RESEARCH_MAX_SOURCES=3
GARVIS_RESEARCH_SOURCE_CHARS=1500

# Gmail OAuth (Phase 9) -- put your downloaded OAuth client secret at this path.
# GARVIS_GMAIL_CLIENT_SECRET_PATH=config/gmail_client_secret.json

# Phone interface (not supported in this beta). Off by default:
# when on, Garvis serves HTTPS on this port to your local network only
# (private address ranges), and only to paired devices.
GARVIS_MOBILE_ENABLED=false
# GARVIS_MOBILE_PORT=8443
# Listen address: 0.0.0.0 = all IPv4 interfaces; or this PC's LAN IP only.
# GARVIS_MOBILE_HOST=0.0.0.0
# Comma-separated CIDRs allowed to connect (empty = private ranges only).
# GARVIS_MOBILE_ALLOWED_NETWORKS=192.168.1.0/24
# Extra names/IPs for the HTTPS certificate (LAN IPs + <pc-name>.local are automatic).
# GARVIS_MOBILE_EXTRA_HOSTS=
# GARVIS_MOBILE_DEVICE_TOKEN_DAYS=30
# GARVIS_MOBILE_MAX_AUDIO_SECONDS=60
# Away from home (Android app only): reach this PC over Tailscale, a private
# network between your own devices -- no router port is opened. Install
# Tailscale on the PC and the phone (same account) first. 'off' = LAN only.
# GARVIS_MOBILE_REMOTE_ACCESS=off
# Tailscale MagicDNS name(s) the app may use, e.g. desktop-xxxx.tailnet.ts.net
# GARVIS_MOBILE_REMOTE_HOSTS=
# Reminders: IANA zone for "8 PM" (empty = the zone the phone reports)
# GARVIS_REMINDERS_TIMEZONE=
# Your name as Garvis says it in reminder calls (optional; English, Hebrew, grammatical gender).
# GARVIS_USER_NAME=
# GARVIS_USER_NAME_HE=
# GARVIS_USER_GENDER=male
# Let the same Claude model word reminder calls (false = built-in wording only, no model call).
# GARVIS_REMINDERS_MODEL_PHRASING=true
# Image generation (separate from the LLM; off unless set). Cloudflare Workers
# AI: on the Free plan requests stop at the daily free allocation.
# GARVIS_IMAGE_PROVIDER=cloudflare
# GARVIS_CLOUDFLARE_ACCOUNT_ID=
# GARVIS_CLOUDFLARE_API_TOKEN=
