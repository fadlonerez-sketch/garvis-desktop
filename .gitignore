# --- Runtime data (databases, logs, recordings, pairing, caches) ----------
# Garvis writes everything it creates at runtime under data/ (see
# app/core/config.py): memory/usage databases, logs, paired devices and the
# local CA, reminders, tasks, screenshots, window state and Piper voices.
data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.log
logs/
*.dmp
*.wav
*.mp3
*.onnx
*.onnx.json

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.spec
.venv/
venv/
env/
.python-version

